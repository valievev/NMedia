<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main"
    app:startDestination="@id/feedFragment">

    <fragment
        android:id="@+id/addEditPostFragment"
        android:name="ru.netology.nmedia.activity.AddEditPostFragment"
        android:label="fragment_add_edit_post"
        tools:layout="@layout/fragment_add_edit_post" />
    <fragment
        android:id="@+id/feedFragment"
        android:name="ru.netology.nmedia.activity.FeedFragment"
        android:label="fragment_feed"
        tools:layout="@layout/fragment_feed" >
        <action
            android:id="@+id/action_feedFragment_to_addEditPostFragment"
            app:destination="@id/addEditPostFragment" />
        <action
            android:id="@+id/action_feedFragment_to_onePostFragment"
            app:destination="@id/onePostFragment" />
    </fragment>
    <fragment
        android:id="@+id/onePostFragment"
        android:name="ru.netology.nmedia.activity.OnePostFragment"
        android:label="fragment_one_post"
        tools:layout="@layout/fragment_one_post" >
        <action
            android:id="@+id/action_onePostFragment_to_addEditPostFragment"
            app:destination="@id/addEditPostFragment" />
    </fragment>
</navigation>
